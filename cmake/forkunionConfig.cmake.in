@PACKAGE_INIT@

# The exported interface names `Threads::Threads`, and an imported target is not a promise the
# consumer's project has already kept - `find_package(forkunion)` must re-find what it links, or the
# first `target_link_libraries` fails on a target nobody defined.
include(CMakeFindDependencyMacro)
find_dependency(Threads)

include("${CMAKE_CURRENT_LIST_DIR}/forkunionTargets.cmake")

# The export defines `forkunion::header`, `forkunion::static`, and `forkunion::shared`. Add the plain
# spellings too, so a consumer can write either:
# ~~~
# target_link_libraries(my_executable PRIVATE forkunion_header)
# target_link_libraries(my_executable PRIVATE forkunion::header)
# ~~~
# `add_subdirectory` consumers get the mirror image from the `ALIAS` targets in `CMakeLists.txt`. The
# plain names keep their prefix - unlike the exported ones they are global, and a bare `static` in the
# consumer's namespace would be a landmine.
#
# Aliasing a non-GLOBAL imported target - which is what `install(EXPORT)` writes - is only legal from
# CMake 3.18, and this file runs under the *consumer's* CMake, not ours. Below that, the namespaced
# spelling still works; only this convenience is skipped, which beats failing the `find_package`.
if (NOT CMAKE_VERSION VERSION_LESS 3.18)
    foreach (_forkunion_flavor header static shared)
        if (NOT TARGET forkunion_${_forkunion_flavor})
            add_library(forkunion_${_forkunion_flavor} ALIAS forkunion::${_forkunion_flavor})
        endif ()
    endforeach ()
    unset(_forkunion_flavor)
endif ()

# The three flavors as components. `check_required_components` reads these, so leaving them unset would
# fail a correct `COMPONENTS static` too.
foreach (_forkunion_flavor header static shared)
    if (TARGET forkunion::${_forkunion_flavor})
        set(forkunion_${_forkunion_flavor}_FOUND TRUE)
    endif ()
endforeach ()
unset(_forkunion_flavor)

# No `forkunion_VERSION` here: `find_package` sets it from the version file before loading this one, and
# the `@PACKAGE_VERSION@` that used to sit here expanded to nothing and overwrote it.
check_required_components(forkunion)
