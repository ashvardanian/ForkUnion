PROJECT_NAME           = ForkUnion
OUTPUT_DIRECTORY       = ../build/
INPUT                  = ../c/forkunion/forkunion.h ../include/forkunion.hpp ../include/forkunion
RECURSIVE              = YES
FILE_PATTERNS          = *.h *.hpp
EXTENSION_MAPPING      = cuh=C++
EXCLUDE_SYMBOLS        = *_
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_ID_STYLE      = GITHUB
BUILTIN_STL_SUPPORT    = YES
TYPEDEF_HIDES_STRUCT   = YES
EXTRACT_ALL            = NO
EXTRACT_STATIC         = YES
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_PROGRAMLISTING     = NO
INPUT_FILTER           = "sed -E 's/^( [*]  )@(author|date) .*/\1/'"
# Every capability on, so each waiter and cache-hints policy renders, not only this host's
PREDEFINED             = FORKUNION_TARGET_X86_PAUSE=1 FORKUNION_TARGET_X86_TPAUSE=1 FORKUNION_TARGET_X86_CLDEMOTE=1 \
                         FORKUNION_TARGET_ARM64_YIELD=1 FORKUNION_TARGET_ARM64_WFE=1 FORKUNION_TARGET_ARM64_WFET=1 \
                         FORKUNION_TARGET_ARM64_PRFM=1 FORKUNION_TARGET_ARM64_DC_CVAC=1 FORKUNION_TARGET_RISCV64_PAUSE=1 \
                         FORKUNION_TARGET_RISCV64_WRS=1 FORKUNION_TARGET_RISCV64_ZICBOM=1 FORKUNION_TARGET_RISCV64_ZICBOP=1
HAVE_DOT               = NO
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_INCOMPLETE_DOC = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
