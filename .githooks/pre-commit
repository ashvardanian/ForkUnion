#!/usr/bin/env bash
#
# ForkUnion pre-commit: enforce the house style on staged changes before they land.
#
# Each check inspects only the ADDED lines of a staged file, so legacy code migrates on its own
# schedule while no new violation sneaks in, and each prints the specific reason when it fires.
# The dispatch loop at the bottom diffs every staged file exactly once and hands the added lines
# to each check through the `file` / `added` globals - the checks themselves are grep one-liners.
# Configuring the CMake build arms these hooks; see the `core.hooksPath` block in CMakeLists.txt.
#
# Bypass knowingly (you almost never should) with: git commit --no-verify

set -u
LC_ALL=C # ? Byte-wise regexes, immune to the committer's locale

failed=0

# Prints the reason and the first offending lines, and marks the commit rejected.
fail() { # fail <matches> <message-line>...
    local matches=$1
    shift
    local line
    for line in "$@"; do echo "pre-commit: $line"; done
    printf '%s\n' "$matches" | head -5
    failed=1
}

# Decorative comment separators - runs of three or more `-` or `=` used purely as visual dividers
# inside a comment. Sections are named by `#pragma region`, and a paragraph that needs a heading gets
# a sentence. A ruler carries no information that the sentence beneath it does not already carry.
check_rulers() {
    local rulers
    rulers=$(printf '%s\n' "$added" | grep -E '^\+(.*(//|/\*)|[[:space:]]*\*).*[-=]{3,}' || true)
    [ -z "$rulers" ] || fail "$rulers" \
        "$file adds a decorative comment separator (--- / ===) - name the section with" \
        "            a #pragma region, or write a plain sentence:"
}

# Documentation is Doxygen, and Doxygen only reads `/** */`. A `//`, `///`, or `///<` comment trailing
# a member or an enumerator is either invisible (`//`) or attached to the WRONG entity (`///` documents
# what follows, so every doc slides down one member and the last is silently lost). Declarations get a
# hovering `/** ... */`; `//` stays for implementation notes inside function bodies. Scope is what
# tells the two apart - a local and a member declare identically - so this tracks brace depth over the
# whole staged file rather than grepping the hunks, and the tree already conforms.
check_trailing_docs() {
    local misplaced
    misplaced=$(
        git show ":$file" | awk '
            # Strings and comments are stripped before the braces are counted, so a `@code` sample
            # inside a docblock opens no scope. What separates a member from a local is that scope
            # and nothing on the line itself, which is why this reads the file rather than the hunks.
            {
                code = $0
                if (in_comment) { pos = index(code, "*/"); code = (pos == 0) ? "" : substr(code, pos + 2); in_comment = (pos == 0) }
                gsub(/"[^"]*"/, "", code)
                gsub(/\047[^\047]*\047/, "", code)
                while ((pos = index(code, "/*")) > 0) {
                    rest = substr(code, pos + 2); tail = index(rest, "*/")
                    if (tail == 0) { code = substr(code, 1, pos - 1); in_comment = 1; break }
                    code = substr(code, 1, pos - 1) substr(rest, tail + 2)
                }
                pos = index(code, "//"); if (pos > 0) code = substr(code, 1, pos - 1)

                # A declaration closes with `,` or `;` before its comment. Judged in the scope this
                # line opens in, so only a member, an enumerator, or an alias can match - and only
                # `using namespace` is the directive that closes the same way without declaring.
                scope = (depth > 0) ? kinds[depth] : "type"
                if (scope == "type" && $0 !~ /^[ \t]*using[ \t]+namespace/ &&
                    $0 ~ /^[ \t]*[A-Za-z_].*[,;][ \t]*\/\/[ \t]*\?/) printf "line %d: trailing // ? on a declaration\n", NR
                if ($0 ~ /^[ \t]*\/\/\//) printf "line %d: /// doc-comment\n", NR

                kind = (code ~ /\)[^;]*\{/) ? "func" : ((code ~ /(^|[^A-Za-z_])(struct|class|enum|union|namespace)([^A-Za-z_]|$)/) ? "type" : "block")
                opens = gsub(/\{/, "{", code); closes = gsub(/\}/, "}", code)
                while (opens-- > 0) kinds[++depth] = kind
                while (closes-- > 0) if (depth > 0) depth--
            }
        '
    )
    [ -z "$misplaced" ] || fail "$misplaced" \
        "$file documents a declaration with a trailing or /// comment - Doxygen either" \
        "            ignores it (//) or attaches it to the next entity (///). Hover a /** ... */ above:"
}

# `@brief` earns its place only when the block has something to separate it from - a body below it, or
# a `@param` / `@retval` / `@sa` section. On a lone paragraph the tag is pure noise, so a one-thought
# docblock reads `/** What this is. */` and gains the tag at the moment a second section appears. A
# docblock is a block rather than a line, so unlike most checks above this validates the whole staged
# file - the tree already conforms.
check_lone_brief() {
    local lone
    lone=$(
        git show ":$file" | awk '
            /\/\*\*/ { in_block = 1; block = ""; opener = NR }
            in_block { block = block "\n" $0 }
            in_block && /\*\// {
                in_block = 0
                if (block ~ /@brief/ &&
                    block !~ /@(param|tparam|return|retval|sa|see|note|warning|throws|pre|post|code|file|author|date|copyright|version|ingroup)/ &&
                    block !~ /\n[ \t]*\*[ \t]*\n/) printf "line %d: lone-paragraph @brief\n", opener
            }
        '
    )
    [ -z "$lone" ] || fail "$lone" \
        "$file tags a lone-paragraph docblock with @brief - the tag only earns its place" \
        "            when a detached body or a @param/@return/@sa section follows it:"
}

# The other direction of the same rule: once a block carries a section, the summary above it needs the
# `@brief` that separates the two, or the summary reads as part of the first section. Only a block that
# has BOTH a prose summary and a section is flagged - a lone paragraph correctly carries no tag, and a
# block that is nothing but a `@return` has no summary to tag.
check_missing_brief() {
    local missing
    missing=$(
        git show ":$file" | awk '
            /\/\*\*/ { in_block = 1; block = ""; opener = NR; first = "" }
            in_block {
                block = block "\n" $0
                if (first == "") {
                    line = $0
                    sub(/^[ \t]*/, "", line)
                    if (NR == opener) sub(/^\/\*\*[ \t]*/, "", line)
                    else sub(/^\*[ \t]*/, "", line)
                    sub(/[ \t]*\*\/[ \t]*$/, "", line)
                    if (line != "") first = line
                }
            }
            in_block && /\*\// {
                in_block = 0
                if (block !~ /@brief/ && block !~ /@file/ && first != "" && first !~ /^@/ &&
                    (block ~ /@(param|tparam|return|retval|sa|see|note|warning|throws|pre|post)/ ||
                     block ~ /\n[ \t]*\*[ \t]*\n/))
                    printf "line %d: a summary and a section, but no @brief\n", opener
            }
        '
    )
    [ -z "$missing" ] || fail "$missing" \
        "$file has a docblock whose summary sits above a section with no @brief between" \
        "            them - the tag is what separates the two:"
}

# `@retval` names one return value per line and binds the FIRST token as that value, so a line opening
# with prose renders a nonsense value column - the same trap `check_section_ids` guards below. This
# codebase says the same thing in one `@return` sentence listing the outcomes, so the tag is unused.
check_retval() {
    local retval
    retval=$(printf '%s\n' "$added" | grep -E '@retval\b' || true)
    [ -z "$retval" ] || fail "$retval" \
        "$file uses @retval - name the outcomes in a single @return sentence instead:"
}

# `@p`, `@b`, `@a`, `@c` and `@ref` each bind the literal next token, so a backticked argument carries
# its backticks into the rendered name - `@p `n`` documents a parameter called "`n`". One marker wins.
# Backticks stay legal everywhere else in a docblock, and in `//` comments.
check_double_markup() {
    local doubled
    doubled=$(printf '%s\n' "$added" | grep -E '@(p|b|a|c|ref)[[:space:]]+`' || true)
    [ -z "$doubled" ] || fail "$doubled" \
        "$file marks one token twice - @p/@b/@a/@c/@ref take the next word literally, so the" \
        "            backticks land inside the name. Drop the backticks and keep the command:"
}

# Every `@param` declares a direction - [in]/[out]/[inout] - so a reader knows whether the callee reads,
# writes, or mutates the argument. A bare `@param` and the comma form `@param[in,out]` are both rejected;
# the one spelling for a mutated argument is `@param[inout]`.
check_param_direction() {
    local undirected
    undirected=$(printf '%s\n' "$added" | grep -E '@param([^[]|\[in,out\])' || true)
    [ -z "$undirected" ] || fail "$undirected" \
        "$file has a @param with no direction, or with the comma form - write @param[in]," \
        "            @param[out], or @param[inout]:"
}

# Every C and C++ file opens with the same four tags in the same order, so a reader lands on the same
# shape whichever file they open, and `@file` carries the repo-relative path because two headers can
# share a basename. `@copyright` is used nowhere here. A header is structure rather than lines, so like
# `check_workflow_names` this reads the whole staged file.
check_file_header() {
    local header
    header=$(
        git show ":$file" | awk '
            NR == 1 && $0 != "/**" { print "line 1: file does not open with a docblock"; exit }
            NR > 1 && /^ \*\// { exit }
            { for (i = 1; i <= NF; i++) if ($i ~ /^@(brief|author|file|date)$/) order = order substr($i, 2, 1) }
            /@file/ { path = $3 }
            END {
                if (order != "" && order != "bafd")
                    print "line 1: header tags read `" order "`, expected @brief @author @file @date"
                if (order == "") print "line 1: header carries none of @brief @author @file @date"
                if (path != "" && path !~ /\//)
                    print "line 1: @file names `" path "`, not the repo-relative path"
            }
        '
    )
    [ -z "$header" ] || fail "$header" \
        "$file has a non-conforming header - open with @brief, @author, @file carrying the" \
        "            repo-relative path, then @date:"
}

# `@section <id> <Title>` binds the FIRST token as the link target and the rest as the visible title, so
# `@section Scheduling Logic` silently anchors "Scheduling" and titles the section "Logic" - the heading
# reads wrong and nothing can link to it. The id is lowercase snake_case carrying its domain, since ids
# share one namespace across the whole Doxygen project: `pool_concurrency_model`, as `flat.hpp` already
# spells it. A Title-Case first token is the exact signature of a missing id, and an id with no title
# renders an empty heading, so both arms are required.
check_section_ids() {
    local sections
    sections=$(printf '%s\n' "$added" | grep -E '@(section|subsection|subsubsection|page)[[:space:]]' |
        grep -vE '@(section|subsection|subsubsection|page)[[:space:]]+[a-z][a-z0-9_]*[[:space:]]+[^[:space:]]' || true)
    [ -z "$sections" ] || fail "$sections" \
        "$file adds a Doxygen section without a lowercase snake_case id, or with an id but" \
        "            no title - Doxygen anchors the first token. Write @section domain_topic Title:"
}

# `@sa` cross-references an identifier, `@see` cross-references a URL. Both tags mean the same thing to
# Doxygen, so nothing but this check keeps the distinction alive - and it is the distinction that makes
# either one scannable.
check_cross_refs() {
    local mixed
    mixed=$(printf '%s\n' "$added" | grep -E '@sa[[:space:]].*https?://|@see[[:space:]]' |
        grep -vE '@see[[:space:]].*https?://' || true)
    [ -z "$mixed" ] || fail "$mixed" \
        "$file mixes the cross-reference tags - @sa names an identifier, @see names a URL:"
}

# Nothing is deprecated: a symbol either exists or it was removed. Carrying a shim past a breaking
# release means every consumer keeps two spellings alive, and neither ever wins.
check_deprecations() {
    local deprecations
    deprecations=$(printf '%s\n' "$added" | grep -iE '@deprecated|#\[deprecated' || true)
    [ -z "$deprecations" ] || fail "$deprecations" \
        "$file adds a deprecation - remove the symbol instead, and say so in the commit:"
}

# Hand-rolled ceiling division - `(n + d - 1) / d` - reimplements a helper the codebase already names:
# `fu::div_ceil` in C++, `.div_ceil()` in Rust, `std.math.divCeil` in Zig. The expression itself is
# harmless; it fires as a SYMPTOM that whoever wrote it has not absorbed the local vocabulary, so the
# rest of that change deserves a second read for other reinvented helpers (see `types.hpp`).
check_hand_ceils() {
    local hand_ceils
    hand_ceils=$(printf '%s\n' "$added" |
        grep -E '\+[[:space:]]*[A-Za-z0-9_.]+[[:space:]]*-[[:space:]]*1\)[[:space:]]*/' || true)
    [ -z "$hand_ceils" ] || fail "$hand_ceils" \
        "$file hand-rolls ceiling division - use fu::div_ceil (C++), .div_ceil() (Rust)," \
        "            std.math.divCeil (Zig), or std.math.ceildiv (Mojo). Not a bug, a symptom: the" \
        "            author didn't know the house" \
        "            vocabulary, so re-validate the rest of this change against types.hpp helpers too:"
}

# A `#pragma region` label must carry no dash. clang-format mis-tokenises `#pragma region - Name`
# (it reflows around the `-`), so the region markers drift out of place on the next format run. Keep
# the label a plain phrase: `#pragma region Name`.
check_region_dashes() {
    local dashed
    dashed=$(printf '%s\n' "$added" | grep -E '^\+[[:space:]]*#pragma[[:space:]]+(end)?region\b[^-]*-' || true)
    [ -z "$dashed" ] || fail "$dashed" \
        "$file has a dash in a #pragma region label - clang-format mishandles it, drop the dash:"
}

# Platform identity belongs to the FU_* vocabulary: types.hpp resolves the raw OS/libc/arch predefines
# once - see its Layer 1 - into FU_ON_* / FU_GLIBC_PREREQ_ / FU_DETECT_ARCH_*, and nothing else may ask
# `__linux__` again. A genuine exception carries an inline `// FU-ALLOW: <reason>`.
check_raw_macros() {
    [ "$file" != include/forkunion/types.hpp ] || return 0 # ? The one file that derives them
    local raw
    raw=$(printf '%s\n' "$added" | grep -vE 'FU-ALLOW' |
        grep -oE '__linux__|__gnu_linux__|__APPLE__|__ANDROID__|__FreeBSD__|_WIN32|_WIN64|\b__unix__?\b|\bunix\b|__GLIBC__|__GLIBC_PREREQ|\b__aarch64__\b|__arm64__|_M_ARM64|\b__x86_64__\b|__amd64__|_M_X64|_M_AMD64|\b__riscv\b' |
        sort -u || true)
    [ -z "$raw" ] || fail "$raw" \
        "$file asks a raw platform macro - use the FU_* vocabulary types.hpp derives" \
        "            (FU_ON_*, FU_GLIBC_PREREQ_, FU_DETECT_ARCH_*), or mark a real exception // FU-ALLOW:"
}

# CI workflows - every job and every step carries a `name:`. An unnamed step renders as its raw
# command in the Actions UI, and job names are what branch protection's required checks reference,
# so an anonymous one can't be pinned. Names are structure, not lines, so unlike the checks above
# this validates the whole staged file - the workflows are small and already conform.
check_workflow_names() {
    local nameless
    nameless=$(
        git show ":$file" | awk '
            # Jobs: two-space keys under the top-level `jobs:` section, named by a four-space `name:`.
            /^jobs:[[:space:]]*$/ { in_jobs = 1; next }
            in_jobs && /^[^ #]/ { in_jobs = 0 }
            in_jobs && /^  [A-Za-z_][A-Za-z0-9_-]*:[[:space:]]*$/ {
                if (job != "" && !job_named) printf "line %d: job `%s` has no name\n", job_line, job
                job = substr($1, 1, length($1) - 1); job_line = NR; job_named = 0
            }
            in_jobs && /^    name:/ { job_named = 1 }
            # Steps: list items two deeper than their `steps:`, named inline or by a key two deeper.
            /^[[:space:]]*steps:[[:space:]]*$/ { steps_at = index($0, "steps:") - 1; item_at = steps_at + 2; pending = 0; next }
            steps_at {
                indent = match($0, /[^ ]/) - 1
                if ($0 ~ /^[[:space:]]*(#|$)/) next
                if (indent <= steps_at) { if (pending) printf "line %d: unnamed step\n", pending; steps_at = 0; next }
                if (indent == item_at && substr($0, item_at + 1, 2) == "- ") {
                    if (pending) printf "line %d: unnamed step\n", pending
                    pending = ($0 ~ /^[[:space:]]*- name:/) ? 0 : NR
                } else if (pending && indent == item_at + 2 && $0 ~ /^[[:space:]]*name:/) pending = 0
            }
            END {
                if (job != "" && !job_named) printf "line %d: job `%s` has no name\n", job_line, job
                if (pending) printf "line %d: unnamed step\n", pending
            }
        '
    )
    [ -z "$nameless" ] || fail "$nameless" \
        "$file has CI jobs or steps without a name - the Actions UI and required" \
        "            checks reference them by it, so every job and step must carry one:"
}

# One pass: enumerate the staged files once, diff each once, and dispatch by extension. The list is
# NUL-delimited so a filename with spaces can never split.
while IFS= read -r -d '' file; do
    added=$(git diff --cached --unified=0 -- "$file" | grep '^+' | grep -v '^+++' || true)
    case "$file" in
    *.c | *.h | *.hpp | *.cpp | *.cc | *.cxx | *.inl)
        check_rulers
        check_section_ids
        check_cross_refs
        check_deprecations
        check_hand_ceils
        check_region_dashes
        check_raw_macros
        check_lone_brief
        check_missing_brief
        check_trailing_docs
        check_retval
        check_double_markup
        check_param_direction
        check_file_header
        ;;
    *.rs | *.zig | *.mojo)
        check_deprecations
        check_hand_ceils
        ;;
    .github/workflows/*.yml | .github/workflows/*.yaml) check_workflow_names ;;
    esac
done < <(git diff --cached --name-only -z --diff-filter=ACM)

# C/C++ - changed lines must satisfy .clang-format. `git clang-format --staged --diff` restricts to the
# staged hunks, so legacy formatting is left untouched.
if command -v git-clang-format > /dev/null 2>&1 && command -v clang-format > /dev/null 2>&1; then
    cpp_staged=()
    while IFS= read -r -d '' file; do cpp_staged+=("$file"); done \
        < <(git diff --cached --name-only -z --diff-filter=ACM -- '*.c' '*.h' '*.cc' '*.cpp' '*.hpp')
    if [ ${#cpp_staged[@]} -gt 0 ]; then
        clang_diff=$(git clang-format --staged --diff -- "${cpp_staged[@]}" 2> /dev/null)
        case "$clang_diff" in
        "" | "no modified files to format" | "clang-format did not modify any files"*) ;;
        *)
            echo "pre-commit: staged C/C++ changes are not clang-format clean on their changed lines - restage after:"
            echo "            git clang-format --staged   (or clang-format -i <file> for the whole file)"
            failed=1
            ;;
        esac
    fi
fi

# Rust - the crate must stay rustfmt-clean (respects rustfmt.toml). Skips without cargo.
if command -v cargo > /dev/null 2>&1; then
    if git diff --cached --name-only --diff-filter=ACM -- '*.rs' | grep -q .; then
        if ! cargo fmt --check > /dev/null 2>&1; then
            echo "pre-commit: staged Rust changes are not rustfmt clean - run: cargo fmt"
            failed=1
        fi
    fi
fi

# Zig - `zig fmt` is the law, and it is not configurable. Skips without zig.
if command -v zig > /dev/null 2>&1; then
    zig_staged=()
    while IFS= read -r -d '' file; do zig_staged+=("$file"); done \
        < <(git diff --cached --name-only -z --diff-filter=ACM -- '*.zig')
    if [ ${#zig_staged[@]} -gt 0 ]; then
        if ! zig fmt --check "${zig_staged[@]}" > /dev/null 2>&1; then
            echo "pre-commit: staged Zig changes are not zig-fmt clean - run: zig fmt ${zig_staged[*]}"
            failed=1
        fi
    fi
fi

# Mojo - `mojo format` is the law, but it has no --check mode, so format a copy and diff. The width
# lives in `pyproject.toml`, which `mojo format` reads the way Black does; it is repeated here
# because the copy sits outside the tree, where that discovery would not find it.
if command -v mojo > /dev/null 2>&1; then
    while IFS= read -r -d '' file; do
        scratch=$(mktemp --suffix=.mojo)
        git show ":$file" > "$scratch"
        mojo format -q -l 120 "$scratch" > /dev/null 2>&1
        if ! git show ":$file" | diff -q - "$scratch" > /dev/null 2>&1; then
            echo "pre-commit: $file is not mojo-format clean - run: mojo format -l 120 $file"
            failed=1
        fi
        rm -f "$scratch"
    done < <(git diff --cached --name-only -z --diff-filter=ACM -- '*.mojo')
fi

# CMake - CMakeLists.txt / *.cmake must satisfy the checked-in .cmake-format.py profile.
if command -v cmake-format > /dev/null 2>&1; then
    while IFS= read -r -d '' file; do
        case "$file" in
        CMakeLists.txt | *.cmake) ;;
        *) continue ;;
        esac
        if ! cmake-format --check "$file" > /dev/null 2>&1; then
            echo "pre-commit: $file is not cmake-format clean - run: cmake-format -i $file"
            failed=1
        fi
    done < <(git diff --cached --name-only -z --diff-filter=ACM)
fi

# YAML/JSON - must satisfy the checked-in .dprint.json (json + pretty_yaml plugins). TOML is handled
# separately by taplo below, because dprint's TOML pass reorders keys and collapses aligned comment
# columns. Skips without dprint (cargo install dprint).
if command -v dprint > /dev/null 2>&1; then
    dprint_staged=()
    while IFS= read -r -d '' file; do dprint_staged+=("$file"); done \
        < <(git diff --cached --name-only -z --diff-filter=ACM -- '*.json' '*.yml' '*.yaml')
    if [ ${#dprint_staged[@]} -gt 0 ]; then
        if ! dprint check "${dprint_staged[@]}" > /dev/null 2>&1; then
            echo "pre-commit: staged YAML/JSON is not dprint clean - run: dprint fmt"
            failed=1
        fi
    fi
fi

# TOML - must satisfy the checked-in .taplo.toml: aligned trailing comments, preserved key order, no
# array reshaping. taplo (not dprint) because it aligns comments without reordering. Skips without
# taplo (cargo install taplo-cli).
if command -v taplo > /dev/null 2>&1; then
    toml_staged=()
    while IFS= read -r -d '' file; do toml_staged+=("$file"); done \
        < <(git diff --cached --name-only -z --diff-filter=ACM -- '*.toml')
    if [ ${#toml_staged[@]} -gt 0 ]; then
        if ! taplo fmt --check "${toml_staged[@]}" > /dev/null 2>&1; then
            echo "pre-commit: staged TOML is not taplo clean - run: taplo fmt"
            failed=1
        fi
    fi
fi

if [ "$failed" -ne 0 ]; then
    echo ""
    echo "Staged changes violate the house style (see the reasons above). Fix and re-stage, or bypass"
    echo "knowingly with: git commit --no-verify"
    exit 1
fi
exit 0
