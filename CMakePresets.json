{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "description": "Ninja, a flat build_<preset> directory, and a compilation database. Select the compiler through a preset, CC/CXX, or CMakeUserPresets.json.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build_${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "FORKUNION_BUILD_TEST": "ON",
        "FORKUNION_BUILD_BENCH": "ON",
        "FORKUNION_WERROR": "ON"
      }
    },
    { "name": "gcc", "hidden": true, "cacheVariables": { "CMAKE_C_COMPILER": "gcc", "CMAKE_CXX_COMPILER": "g++" } },
    {
      "name": "clang",
      "hidden": true,
      "cacheVariables": { "CMAKE_C_COMPILER": "clang", "CMAKE_CXX_COMPILER": "clang++" }
    },
    {
      "name": "darwin",
      "hidden": true,
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    },
    {
      "name": "windows",
      "hidden": true,
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "cross",
      "hidden": true,
      "description": "Correctness only: emulators cannot run the throughput suite in time, and the benchmarks stay host-only.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "FORKUNION_TEST_SKIP_STRESS": "ON",
        "FORKUNION_BUILD_BENCH": "OFF"
      }
    },
    {
      "name": "debug",
      "inherits": ["base", "clang"],
      "displayName": "Debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "inherits": ["base", "clang"],
      "displayName": "Release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "check",
      "inherits": ["base", "clang"],
      "displayName": "Clang with warnings as errors",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_FLAGS_RELWITHDEBINFO": "-O0 -g0 -DNDEBUG",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O0 -g0 -DNDEBUG",
        "FORKUNION_WERROR": "ON"
      }
    },
    {
      "name": "asan",
      "inherits": ["base", "clang"],
      "displayName": "AddressSanitizer + UndefinedBehaviorSanitizer",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "FORKUNION_BUILD_BENCH": "OFF",
        "FORKUNION_BUILD_SANITIZERS": "address"
      }
    },
    {
      "name": "tsan",
      "inherits": ["base", "clang"],
      "displayName": "ThreadSanitizer",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "FORKUNION_BUILD_BENCH": "OFF",
        "FORKUNION_BUILD_SANITIZERS": "thread"
      }
    },
    {
      "name": "msvc2026_x64",
      "inherits": ["base", "windows"],
      "displayName": "Windows x64 - Visual Studio 2026",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64"
    },
    {
      "name": "msvc2022_x64",
      "inherits": "msvc2026_x64",
      "displayName": "Windows x64 - Visual Studio 2022",
      "generator": "Visual Studio 17 2022"
    },
    {
      "name": "msvc2026_arm64",
      "inherits": ["base", "windows"],
      "displayName": "Windows ARM64 - Visual Studio 2026",
      "generator": "Visual Studio 18 2026",
      "architecture": "ARM64"
    },
    {
      "name": "msvc2022_arm64",
      "inherits": "msvc2026_arm64",
      "displayName": "Windows ARM64 - Visual Studio 2022",
      "generator": "Visual Studio 17 2022"
    },
    {
      "name": "dockcross",
      "inherits": "cross",
      "displayName": "Whatever target the dockcross image's toolchain names",
      "description": "Static, so the binaries QEMU runs need no shared libatomic or libstdc++ from the target.",
      "toolchainFile": "$env{CMAKE_TOOLCHAIN_FILE}",
      "cacheVariables": { "CMAKE_EXE_LINKER_FLAGS": "-static" }
    },
    {
      "name": "android_arm64",
      "inherits": "cross",
      "displayName": "Whichever ABI the Android NDK r28+ toolchain file names, compile only",
      "toolchainFile": "$env{CMAKE_TOOLCHAIN_FILE}"
    },
    {
      "name": "wasm32_emscripten",
      "inherits": "cross",
      "toolchainFile": "${sourceDir}/cmake/toolchain-wasm32-emscripten.cmake",
      "cacheVariables": { "CMAKE_CROSSCOMPILING_EMULATOR": "node" }
    },
    {
      "name": "wasm64_emscripten",
      "inherits": "cross",
      "toolchainFile": "${sourceDir}/cmake/toolchain-wasm64-emscripten.cmake",
      "cacheVariables": { "CMAKE_CROSSCOMPILING_EMULATOR": "node" }
    },
    {
      "name": "wasm32_wasi_threads",
      "inherits": "cross",
      "toolchainFile": "${sourceDir}/cmake/toolchain-wasm32-wasi-threads.cmake"
    },
    {
      "name": "ios",
      "inherits": ["release", "darwin"],
      "displayName": "iOS device, compile only",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_SYSROOT": "iphoneos",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "17.0"
      }
    },
    {
      "name": "ios_simulator",
      "inherits": ["release", "darwin"],
      "displayName": "iOS Simulator",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_SYSROOT": "iphonesimulator",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "17.0"
      }
    },
    {
      "name": "machine",
      "hidden": true,
      "inherits": ["base", "clang"],
      "description": "Libraries for one machine: its CPU floor, every kernel-library capability spelled as 1 or 0, and its one GPU code.",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "FORKUNION_BUILD_TEST": "OFF",
        "FORKUNION_BUILD_BENCH": "OFF",
        "FORKUNION_MULTIVERSIONED": "OFF"
      }
    },
    {
      "name": "xeon4_hopper",
      "inherits": "machine",
      "displayName": "Xeon 4 with Hopper - compile only",
      "cacheVariables": {
        "FORKUNION_MARCH": "sapphirerapids",
        "FORKUNION_TARGET_X86_PAUSE": "1",
        "FORKUNION_TARGET_X86_TPAUSE": "1",
        "FORKUNION_TARGET_X86_CLDEMOTE": "1",
        "FORKUNION_TARGET_X86_CMPCCXADD": "0",
        "FORKUNION_TARGET_X86_RAOINT": "0"
      }
    },
    {
      "name": "xeon6_blackwell",
      "inherits": "machine",
      "displayName": "Xeon 6 with Blackwell - compile only",
      "cacheVariables": {
        "FORKUNION_MARCH": "graniterapids",
        "FORKUNION_TARGET_X86_PAUSE": "1",
        "FORKUNION_TARGET_X86_TPAUSE": "1",
        "FORKUNION_TARGET_X86_CLDEMOTE": "1",
        "FORKUNION_TARGET_X86_CMPCCXADD": "0",
        "FORKUNION_TARGET_X86_RAOINT": "0"
      }
    },
    {
      "name": "grace_hopper",
      "inherits": "machine",
      "displayName": "Grace with Hopper - compile only",
      "description": "Grace's 128-bit SVE gains nothing over NEON, so every SVE capability is off.",
      "cacheVariables": {
        "FORKUNION_MARCH": "grace",
        "FORKUNION_TARGET_ARM64_YIELD": "1",
        "FORKUNION_TARGET_ARM64_WFET": "0",
        "FORKUNION_TARGET_ARM64_DC_CVAC": "1",
        "FORKUNION_TARGET_ARM64_PRFM": "1",
        "FORKUNION_TARGET_ARM64_LSE": "1",
        "FORKUNION_TARGET_ARM64_RCPC": "1"
      }
    },
    {
      "name": "vera_rubin",
      "inherits": "machine",
      "displayName": "Vera with Rubin - compile only",
      "description": "Olympus cores need Clang 22 or GCC 15 and CUDA 13.4 names no Rubin code, so it compiles 100f; WFET is on, as no compiler macro reports it, and SVE off, as on Grace.",
      "cacheVariables": {
        "FORKUNION_MARCH": "olympus",
        "FORKUNION_TARGET_ARM64_YIELD": "1",
        "FORKUNION_TARGET_ARM64_WFET": "1",
        "FORKUNION_TARGET_ARM64_DC_CVAC": "1",
        "FORKUNION_TARGET_ARM64_PRFM": "1",
        "FORKUNION_TARGET_ARM64_LSE": "1",
        "FORKUNION_TARGET_ARM64_RCPC": "1"
      }
    },
    {
      "name": "venice_mi450",
      "inherits": "machine",
      "displayName": "EPYC Venice with MI450 - compile only",
      "description": "Clang 22 names no Zen 6 core, so it compiles at znver5 and spells the rows GCC 16's znver6 implies; gfx1250 covers MI450X and MI455X.",
      "cacheVariables": {
        "FORKUNION_MARCH": "znver5",
        "FORKUNION_TARGET_X86_PAUSE": "1",
        "FORKUNION_TARGET_X86_TPAUSE": "0",
        "FORKUNION_TARGET_X86_CLDEMOTE": "1",
        "FORKUNION_TARGET_X86_CMPCCXADD": "0",
        "FORKUNION_TARGET_X86_RAOINT": "0"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "check", "configurePreset": "check" },
    { "name": "release", "configurePreset": "release" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "tsan", "configurePreset": "tsan", "targets": ["forkunion_test_cpp20", "forkunion_test_cpp23"] },
    { "name": "msvc2026_x64", "configurePreset": "msvc2026_x64", "configuration": "RelWithDebInfo" },
    { "name": "msvc2022_x64", "configurePreset": "msvc2022_x64", "configuration": "RelWithDebInfo" },
    { "name": "msvc2026_arm64", "configurePreset": "msvc2026_arm64", "configuration": "RelWithDebInfo" },
    { "name": "msvc2022_arm64", "configurePreset": "msvc2022_arm64", "configuration": "RelWithDebInfo" },
    { "name": "dockcross", "configurePreset": "dockcross", "targets": ["forkunion_test_cpp20", "forkunion_test_c11"] },
    {
      "name": "android_arm64",
      "configurePreset": "android_arm64",
      "targets": ["forkunion_test_cpp20", "forkunion_test_c11"]
    },
    {
      "name": "wasm32_emscripten",
      "configurePreset": "wasm32_emscripten",
      "targets": ["forkunion_test_cpp20", "forkunion_test_c11"]
    },
    {
      "name": "wasm64_emscripten",
      "configurePreset": "wasm64_emscripten",
      "targets": ["forkunion_test_cpp20", "forkunion_test_c11"]
    },
    {
      "name": "wasm32_wasi_threads",
      "configurePreset": "wasm32_wasi_threads",
      "targets": ["forkunion_test_cpp20", "forkunion_test_c11"]
    },
    { "name": "ios", "configurePreset": "ios", "targets": ["forkunion_test_cpp20", "forkunion_static"] },
    {
      "name": "ios_simulator",
      "configurePreset": "ios_simulator",
      "targets": ["forkunion_test_cpp20", "forkunion_static"]
    },
    { "name": "xeon4_hopper", "configurePreset": "xeon4_hopper" },
    { "name": "xeon6_blackwell", "configurePreset": "xeon6_blackwell" },
    { "name": "grace_hopper", "configurePreset": "grace_hopper" },
    { "name": "vera_rubin", "configurePreset": "vera_rubin" },
    { "name": "venice_mi450", "configurePreset": "venice_mi450" }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "filter": { "include": { "name": "^forkunion_test_" } }
    },
    { "name": "debug", "inherits": "base", "configurePreset": "debug" },
    { "name": "release", "inherits": "base", "configurePreset": "release" },
    {
      "name": "asan",
      "inherits": "base",
      "configurePreset": "asan"
    },
    {
      "name": "tsan",
      "inherits": "base",
      "configurePreset": "tsan",
      "filter": { "include": { "name": "^forkunion_test_cpp" } },
      "environment": { "TSAN_OPTIONS": "halt_on_error=1" }
    },
    {
      "name": "msvc2026_x64",
      "inherits": "base",
      "configurePreset": "msvc2026_x64",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "msvc2022_x64",
      "inherits": "base",
      "configurePreset": "msvc2022_x64",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "msvc2026_arm64",
      "inherits": "base",
      "configurePreset": "msvc2026_arm64",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "msvc2022_arm64",
      "inherits": "base",
      "configurePreset": "msvc2022_arm64",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "dockcross",
      "inherits": "base",
      "configurePreset": "dockcross",
      "filter": { "include": { "name": "^forkunion_test_(cpp20|c11)$" } }
    },
    {
      "name": "wasm32_emscripten",
      "inherits": "base",
      "configurePreset": "wasm32_emscripten",
      "filter": { "include": { "name": "^forkunion_test_c11$" } }
    },
    {
      "name": "wasm64_emscripten",
      "inherits": "base",
      "configurePreset": "wasm64_emscripten",
      "filter": { "include": { "name": "^forkunion_test_(cpp20|c11)$" } }
    },
    {
      "name": "wasm32_wasi_threads",
      "inherits": "base",
      "configurePreset": "wasm32_wasi_threads",
      "filter": { "include": { "name": "^forkunion_test_(cpp20|c11)$" } }
    }
  ],
  "workflowPresets": [
    {
      "name": "debug",
      "steps": [
        { "type": "configure", "name": "debug" },
        { "type": "build", "name": "debug" },
        { "type": "test", "name": "debug" }
      ]
    },
    {
      "name": "release",
      "steps": [
        { "type": "configure", "name": "release" },
        { "type": "build", "name": "release" },
        { "type": "test", "name": "release" }
      ]
    },
    {
      "name": "asan",
      "steps": [
        { "type": "configure", "name": "asan" },
        { "type": "build", "name": "asan" },
        { "type": "test", "name": "asan" }
      ]
    },
    {
      "name": "tsan",
      "steps": [
        { "type": "configure", "name": "tsan" },
        { "type": "build", "name": "tsan" },
        { "type": "test", "name": "tsan" }
      ]
    },
    {
      "name": "wasm32_wasi_threads",
      "steps": [
        { "type": "configure", "name": "wasm32_wasi_threads" },
        { "type": "build", "name": "wasm32_wasi_threads" },
        { "type": "test", "name": "wasm32_wasi_threads" }
      ]
    }
  ]
}
